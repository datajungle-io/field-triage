<?xml version="1.0" encoding="UTF-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Field Triage CRM Writer</label>
    <contactEmail>brendan@datajungle.io</contactEmail>
    <description>Server-to-server writer for triage.datajungle.io. Upserts a Lead per scanned org using the JWT bearer flow. No interactive login.</description>
    <oauthConfig>
        <!-- Unused by the JWT bearer flow, which never redirects, but the
             metadata type requires a callback URL. -->
        <callbackUrl>http://localhost:1717/OauthRedirect</callbackUrl>
        <certificate></certificate>
        <!-- Pre-authorised, scoped to the permission set that already grants
             FLS on Field_Triage_Org_Id__c. Without this the JWT exchange fails
             with "user hasn't approved this consumer". -->
        <isAdminApproved>true</isAdminApproved>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
    </oauthConfig>
    <permissionSetName>Field Triage CRM Writer</permissionSetName>
</ConnectedApp>
