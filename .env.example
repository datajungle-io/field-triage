# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin, no trailing slash. Must match the Connected App callback URL.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Salesforce Connected App
#
# Create in a Developer Edition / Dev Hub org:
#   Setup > App Manager > New Connected App
#   - Enable OAuth Settings
#   - Callback URL:  ${APP_URL}/api/auth/callback
#   - Selected scopes: "Manage user data via APIs (api)"
#                      "Access the identity URL service (id, profile, email)"
#   - Do NOT select "Perform requests at any time (refresh_token, offline_access)"
#   - Require PKCE: enabled
#   - Manage > Permitted Users: "All users may self-authorize"
#   - Manage > IP Relaxation: "Relax IP restrictions"
#
# The consumer key works across orgs; only orgs with API Access Control enabled
# need to whitelist it explicitly.
# ---------------------------------------------------------------------------
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Service role — bypasses RLS. Server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI, used only by `npm run db:push`.
# Project Settings > Database > Connection string > URI (session pooler, NOT
# the transaction pooler — migrations create types and functions).
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Encryption for the Salesforce access token at rest.
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Lead alerts (all optional — a missing config makes notification a no-op)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_ALERT_EMAIL=
LEAD_ALERT_FROM=
LEAD_ALERT_WEBHOOK=

# ---------------------------------------------------------------------------
# Cron auth. Vercel Cron sends this automatically as a Bearer token when set;
# the Netlify scheduled function reads it from the environment and sends it.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Host function limits.
#
# The scan is a resumable job, so a tight ceiling means more, shorter ticks and
# the same result. But these MUST sit inside the platform's function timeout —
# a tick killed before it returns can't persist its cursor, and the phase would
# repeat the same work indefinitely.
#
#   Netlify free   (10s)  ->  SCAN_TICK_BUDGET_MS=7000   CRON_BUDGET_MS=7000
#   Netlify Pro    (26s)  ->  SCAN_TICK_BUDGET_MS=20000  CRON_BUDGET_MS=20000
#   Vercel Hobby   (60s)  ->  SCAN_TICK_BUDGET_MS=35000  CRON_BUDGET_MS=45000
#   Vercel Pro    (300s)  ->  SCAN_TICK_BUDGET_MS=35000  CRON_BUDGET_MS=240000
#
# Defaults (20000) are conservative so an unconfigured deploy works anywhere.
# ---------------------------------------------------------------------------
SCAN_TICK_BUDGET_MS=
CRON_BUDGET_MS=

# ---------------------------------------------------------------------------
# Local testing without a Connected App.
#
# Enables /api/dev/scan?org=<alias>, which starts a scan from the `sf` CLI's
# existing session. Refuses to run when NODE_ENV=production. Scans started this
# way are flagged is_cli_session so finalize does NOT revoke the token — that
# would log you out of `sf`.
# ---------------------------------------------------------------------------
ALLOW_CLI_SCAN=
